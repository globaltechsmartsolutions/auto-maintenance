generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyPlan {
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum LeadStatus {
  NEW
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum CustomerStatus {
  ACTIVE
  PAUSED
  AT_RISK
  ARCHIVED
}

enum CustomerType {
  RESIDENTIAL
  BUSINESS
  COMMUNITY
  INDUSTRIAL
}

enum ServiceStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRecurrence {
  ONE_TIME
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EmployeeFieldStatus {
  AVAILABLE
  ASSIGNED
  VACATION
  SICK_LEAVE
  INACTIVE
}

enum BookingRequestStatus {
  PENDING
  SCHEDULED
  AUTO_ASSIGNED
  COMPLETED
  CANCELLED
}

enum AssignmentMode {
  PENDING
  RECOMMENDED
  MANUAL
  AUTO_ASSIGNED
}

enum AssignmentDecisionType {
  AUTO_ASSIGNED
  MANAGER_CONFIRMED
  MANAGER_OVERRIDE
}

enum AutomationTrigger {
  SERVICE_REMINDER
  SERVICE_CONFIRMATION
  FOLLOW_UP
  REVIEW_REQUEST
  FAILED_PAYMENT
}

model Company {
  id                   String             @id @default(uuid())
  name                 String
  fiscalName           String?
  cif                  String?
  email                String?
  phone                String?
  website              String?
  address              String?
  city                 String?
  province             String?
  postalCode           String?
  country              String             @default("ES")
  billingEmail         String?
  logoUrl              String?
  plan                 CompanyPlan        @default(STARTER)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users       User[]
  employees   Employee[]
  customers   Customer[]
  leads       Lead[]
  services    Service[]
  quotes      Quote[]
  invoices    Invoice[]
  payments    Payment[]
  automations AutomationRule[]
  bookingRequests BookingRequest[]
  assignmentDecisions AssignmentDecision[]
  integrations Integration[]
  auditLogs   AuditLog[]

  @@index([subscriptionStatus])
  @@index([plan])
}

model User {
  id             String     @id @default(uuid())
  companyId      String?
  supabaseUserId String?    @unique
  email          String     @unique
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  role           UserRole   @default(EMPLOYEE)
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company         Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile Employee?
  assignedLeads   Lead[]         @relation("LeadOwner")
  auditLogs       AuditLog[]

  @@index([companyId, role])
}

model Employee {
  id               String   @id @default(uuid())
  companyId        String
  userId           String   @unique
  position         String?
  fieldStatus      EmployeeFieldStatus @default(AVAILABLE)
  hourlyRate       Decimal? @db.Decimal(10, 2)
  availability     Json?
  performanceScore Int      @default(0)
  internalNotes    String?
  skills           String[] @default([])
  zones            String[] @default([])
  preferredServiceTypes String[] @default([])
  maxJobsPerDay    Int?
  maxHoursPerDay   Int?
  incidentRate     Decimal  @default(0) @db.Decimal(5, 2)
  hiredAt          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      ServiceAssignment[]
  assignedBookingRequests BookingRequest[] @relation("BookingAssignedEmployee")
  suggestedBookingRequests BookingRequest[] @relation("BookingSuggestedEmployee")
  recommendedDecisions AssignmentDecision[] @relation("AssignmentRecommendedEmployee")
  selectedDecisions AssignmentDecision[] @relation("AssignmentSelectedEmployee")

  @@index([companyId])
  @@index([companyId, fieldStatus])
}

model Customer {
  id           String         @id @default(uuid())
  companyId    String
  name         String
  type         CustomerType   @default(BUSINESS)
  status       CustomerStatus @default(ACTIVE)
  email        String?
  phone        String?
  nif          String?
  address      String?
  city         String?
  province     String?
  postalCode   String?
  tags         String[]       @default([])
  notes        String?
  lifetimeValue Decimal       @default(0) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services Service[]
  quotes   Quote[]
  invoices Invoice[]
  bookingRequests BookingRequest[]
  notesLog CustomerNote[]

  @@index([companyId, status])
  @@index([companyId, type])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String     @id @default(uuid())
  companyId     String
  assignedToId  String?
  name          String
  companyName   String?
  email         String?
  phone         String?
  source        String?
  status        LeadStatus @default(NEW)
  estimatedValue Decimal   @default(0) @db.Decimal(12, 2)
  probability   Int        @default(10)
  nextFollowUp  DateTime?
  tags          String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?      @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      LeadNote[]
  bookingRequests BookingRequest[]

  @@index([companyId, status])
  @@index([assignedToId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Service {
  id             String            @id @default(uuid())
  companyId      String
  customerId     String
  sourceQuoteId  String?           @unique
  title          String
  description    String?
  serviceType    String
  recurrence     ServiceRecurrence @default(ONE_TIME)
  status         ServiceStatus     @default(PENDING)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  address        String?
  city           String?
  price          Decimal           @default(0) @db.Decimal(12, 2)
  vatRate        Decimal           @default(21) @db.Decimal(5, 2)
  internalNotes  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceQuote  Quote?              @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  assignments  ServiceAssignment[]
  bookingRequest BookingRequest?
  assignmentDecisions AssignmentDecision[]
  invoiceItems InvoiceItem[]

  @@index([companyId, status])
  @@index([customerId])
  @@index([scheduledStart])
}

model BookingRequest {
  id                  String               @id @default(uuid())
  companyId           String
  customerId          String?
  leadId              String?
  serviceId           String?              @unique
  assignedEmployeeId  String?
  suggestedEmployeeId String?
  customerName        String
  contactName         String?
  email               String?
  phone               String?
  title               String
  city                String?
  address             String?
  preferredStart      DateTime?
  description         String?
  status              BookingRequestStatus @default(PENDING)
  assignmentMode      AssignmentMode       @default(PENDING)
  estimatedPrice      Decimal              @default(0) @db.Decimal(12, 2)
  assignmentSummary   String?
  assignmentReasons   String[]             @default([])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead              Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service           Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedEmployee  Employee?            @relation("BookingAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  suggestedEmployee Employee?            @relation("BookingSuggestedEmployee", fields: [suggestedEmployeeId], references: [id], onDelete: SetNull)
  assignmentDecisions AssignmentDecision[]

  @@index([companyId, status])
  @@index([companyId, preferredStart])
  @@index([customerId])
  @@index([leadId])
  @@index([assignedEmployeeId])
  @@index([suggestedEmployeeId])
}

model AssignmentDecision {
  id                    String                 @id @default(uuid())
  companyId             String
  serviceId             String?
  bookingRequestId      String?
  recommendedEmployeeId String?
  selectedEmployeeId    String?
  serviceTitle          String
  serviceFamily         String?
  customerName          String
  city                  String?
  decisionType          AssignmentDecisionType
  wasAcceptedByManager  Boolean                @default(false)
  resultLabel           String?
  reasons               String[]               @default([])
  createdAt             DateTime               @default(now())

  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service             Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  bookingRequest      BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  recommendedEmployee Employee?       @relation("AssignmentRecommendedEmployee", fields: [recommendedEmployeeId], references: [id], onDelete: SetNull)
  selectedEmployee    Employee?       @relation("AssignmentSelectedEmployee", fields: [selectedEmployeeId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([serviceId])
  @@index([bookingRequestId])
  @@index([recommendedEmployeeId])
  @@index([selectedEmployeeId])
}

model ServiceAssignment {
  id         String   @id @default(uuid())
  serviceId  String
  employeeId String
  role       String?
  createdAt  DateTime @default(now())

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([serviceId, employeeId])
}

model Quote {
  id          String      @id @default(uuid())
  companyId   String
  customerId  String
  number      String
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems        QuoteLineItem[]
  convertedService Service?

  @@unique([companyId, number])
  @@index([companyId, status])
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  quoteId     String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @default(21) @db.Decimal(5, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                    String        @id @default(uuid())
  companyId             String
  customerId            String
  number                String
  status                InvoiceStatus @default(DRAFT)
  issueDate             DateTime      @default(now())
  dueDate               DateTime?
  subtotal              Decimal       @default(0) @db.Decimal(12, 2)
  vatAmount             Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @default(0) @db.Decimal(12, 2)
  pdfUrl                String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @default(21) @db.Decimal(5, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Payment {
  id             String        @id @default(uuid())
  companyId      String
  invoiceId      String?
  provider       String        @default("stripe")
  providerRef    String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("eur")
  status         PaymentStatus @default(PENDING)
  failureMessage String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

model AutomationRule {
  id          String            @id @default(uuid())
  companyId   String
  name        String
  trigger     AutomationTrigger
  channel     String            @default("email")
  delayHours  Int               @default(0)
  isActive    Boolean           @default(true)
  template    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, trigger])
}

model Integration {
  id          String   @id @default(uuid())
  companyId   String
  provider    String
  status      String   @default("ready")
  config      Json?
  connectedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
}
