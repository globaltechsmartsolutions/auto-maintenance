# PostgreSQL / Supabase database
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limpiapro?schema=public"
# Supabase preproduction example:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limpiapro?schema=public"

# Demo mode
# Local demo can use true. Preproduction must use false.
NEXT_PUBLIC_DEMO_MODE="false"
DEMO_MODE="false"
DEMO_ROLE="ADMIN"
# The sales CRM is optional and remains hidden in WIAControl by default.
NEXT_PUBLIC_CRM_ENABLED="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe test mode for preproduction
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""

# Stage 3 scheduled incident detection (Vercel Cron -> /api/cron/detect-incidents).
# Vercel automatically sends this as a Bearer token when set; generate a
# long random value and set it in the deployment environment, never here.
CRON_SECRET=""

# Stage 5 communications outbox worker (Vercel Cron -> /api/cron/process-outbox,
# same CRON_SECRET as above). EMAIL delivery uses Resend (https://resend.com).
# Without RESEND_API_KEY, EMAIL messages fail honestly and become visibly
# FAILED after bounded retries -- IN_APP delivery does not need this and
# always works, since it has no external provider to call.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional AI Operations Brief. This runs only on the server, is disabled by
# default, and must be covered by the customer's privacy review and DPA.
AI_GATEWAY_API_KEY=""
AI_OPERATIONS_BRIEF_ENABLED="false"

# Private evidence storage (Supabase Storage). The bucket MUST be private:
# the application refuses to issue an upload link for a public bucket. Files
# are written under companies/<companyId>/... and are only ever read through
# a short-lived signed URL, so no evidence is addressable without a session.
SUPABASE_EVIDENCE_BUCKET=""

# Evidence retention runs daily (Vercel Cron -> /api/cron/purge-evidence,
# same CRON_SECRET as above) and deletes files past the company's
# clockRetentionYears window from storage as well as from the metadata.
