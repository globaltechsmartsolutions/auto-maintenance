{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run prisma:generate && npm run build",
  "crons": [
    {
      "path": "/api/cron/detect-incidents",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-evidence",
      "schedule": "30 3 * * *"
    }
  ]
}
